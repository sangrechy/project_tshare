# Dependencies
node_modules/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Local storage and user-transferred content
uploads/*
!uploads/.gitkeep
files/*
!files/.gitkeep

# Large media files
*.mp4
*.mkv
*.avi
*.zip
*.tar.gz
!share_by_ethernet_tool/v1.zip
!share_by_ethernet_tool/v2.zip

# Logs and runtime states
*.log
npm-debug.log*
*.json.state
*.cert

# Environment & OS files
.env
.DS_Store
Thumbs.db

# Databases & Runtime Leases
*.db
share_lease.json
tshare_history.db
.tshare_*
*.tshare_state*

